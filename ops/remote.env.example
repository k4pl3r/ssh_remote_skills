# Copy this file to ops/remote.env and adjust values for your environment.

# Required
REMOTE_HOST="your-remote-host-or-ip"
REMOTE_USER="your-ssh-user"
REMOTE_PROJECT_DIR="/srv/your-project"

# Required for test commands
REMOTE_TEST_QUICK_CMD="pytest -q tests/smoke"
REMOTE_TEST_FULL_CMD="pytest -q"

# Optional: enable strict command whitelist for "ops/remote run <cmd>"
REMOTE_ALLOWED_RUN_REGEX="^(make|pytest|npm|pnpm|yarn|go|cargo|echo|./).*"

# Optional: remote log directory (default: $REMOTE_PROJECT_DIR/.codex-remote-logs)
REMOTE_LOG_DIR="/srv/your-project/.codex-remote-logs"

# Optional: choose local source dir to sync (default: repo root)
# REMOTE_LOCAL_SOURCE_DIR="/Users/yourname/path/to/repo"

# Optional: path to rsync exclude file (default: .rsyncignore in repo root)
# REMOTE_RSYNC_EXCLUDE_FILE="/Users/yourname/path/to/repo/.rsyncignore"

# Optional: remote safety gate before rsync --delete (1 enable / 0 disable)
REMOTE_SYNC_REQUIRE_CLEAN_GIT="1"

# Optional: rsync settings
REMOTE_RSYNC_DELETE="1"
# REMOTE_RSYNC_EXTRA_ARGS="--stats"

# Optional: enable tmux wrapping for full tests if tmux is available remotely
REMOTE_USE_TMUX="0"

# Optional: retries and SSH options
REMOTE_SSH_RETRIES="2"
REMOTE_SSH_RETRY_DELAY="2"
REMOTE_RSYNC_RETRIES="2"
REMOTE_RSYNC_RETRY_DELAY="2"
# REMOTE_SSH_OPTS="-o ControlMaster=auto -o ControlPersist=10m -o ControlPath=~/.ssh/cm-%r@%h:%p"

# Place this file on remote host as:
#   /srv/project/ops/remote-mcp-runner.env
# and update values to match your project.

MCP_REMOTE_PROJECT_DIR="/srv/project"
MCP_REMOTE_LOG_DIR="/srv/project/.codex-remote-logs"

# Fast checks after each edit
MCP_REMOTE_TEST_QUICK_CMD="pytest -q tests/smoke"

# Full validation for milestones/releases
MCP_REMOTE_TEST_FULL_CMD="pytest -q"

# Optional command guard for "run" mode
MCP_REMOTE_RUN_WHITELIST='^(make|pytest|echo|./).*'
